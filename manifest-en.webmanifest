{
  "name": "Rature · PDF editor",
  "short_name": "Rature",
  "description": "Fill in, sign and fix PDFs for free, right in your browser.",
  "lang": "en",
  "start_url": "./en/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbf8f0",
  "theme_color": "#fbf8f0",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./en/",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
